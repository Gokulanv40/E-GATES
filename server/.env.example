# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/association_db

# JWT Authentication
JWT_SECRET=super_secret_jwt_access_key_change_in_production_123456
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_change_in_production_654321
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Layout Association <no-reply@association.com>"

# SMS Service Configuration
# Provider choices: fast2sms | twilio | msg91
SMS_PROVIDER=fast2sms
SMS_API_KEY=your_sms_api_key_here

# Twilio Specific Configuration (if SMS_PROVIDER=twilio)
TWILIO_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE=+1234567890
